{
  "AllowedHosts": "*",
  "CustomerOidc": {
    "Audience": "davids-services",
    "ClockSkewSeconds": 30
  },
  "AdminOidc": {
    "Audience": "davids-admin",
    "BffClientId": "davids-admin-bff",
    "PublicAuthorizeEndpoint": "/admin-identity/connect/authorize",
    "SessionHours": 8,
    "ClockSkewSeconds": 30
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "AdminAuthPermitLimit": 10,
    "CustomerAuthPermitLimit": 30,
    "ApiPermitLimit": 120
  },
  "Redis": {
    "Enabled": false
  },
  "Vault": {
    "Enabled": false,
    "KvPath": "secret/data/davids/gateway"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-sign-up-public": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-customer-auth",
        "Match": {
          "Path": "/identity/sign-up"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-oidc-discovery-public": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/identity/.well-known/{**remainder}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-oidc-userinfo": {
        "ClusterId": "identity",
        "Order": -120,
        "AuthorizationPolicy": "customer-authenticated",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/identity/connect/userinfo",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-oidc-authorize-public": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-customer-auth",
        "Match": {
          "Path": "/identity/connect/authorize",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-oidc-authorize-css-public": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/identity/connect/authorize.css",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-oidc-token-public": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-customer-auth",
        "Match": {
          "Path": "/identity/connect/token",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-oidc-revocation-public": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-customer-auth",
        "Match": {
          "Path": "/identity/connect/revocation",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-oidc-logout-public": {
        "ClusterId": "identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-customer-auth",
        "Match": {
          "Path": "/identity/connect/logout",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-user-self-or-admin": {
        "ClusterId": "identity",
        "Order": -50,
        "AuthorizationPolicy": "resource-owner-or-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/identity/users/{userId}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "identity-authenticated": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "customer-authenticated",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/identity/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-oidc-discovery-public": {
        "ClusterId": "admin-identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/admin-identity/.well-known/{**remainder}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-oidc-userinfo": {
        "ClusterId": "admin-identity",
        "Order": -120,
        "AuthorizationPolicy": "customers-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/admin-identity/connect/userinfo",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-oidc-authorize-public": {
        "ClusterId": "admin-identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-admin-auth",
        "Match": {
          "Path": "/admin-identity/connect/authorize",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-oidc-authorize-css-public": {
        "ClusterId": "admin-identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/admin-identity/connect/authorize.css",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-oidc-token-public": {
        "ClusterId": "admin-identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-admin-auth",
        "Match": {
          "Path": "/admin-identity/connect/token",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-oidc-revocation-public": {
        "ClusterId": "admin-identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-admin-auth",
        "Match": {
          "Path": "/admin-identity/connect/revocation",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-oidc-logout-public": {
        "ClusterId": "admin-identity",
        "Order": -100,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway-admin-auth",
        "Match": {
          "Path": "/admin-identity/connect/logout",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin-identity-protected": {
        "ClusterId": "admin-identity",
        "AuthorizationPolicy": "customers-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/admin-identity/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/admin-identity" },
          { "X-Forwarded": "Set" }
        ]
      },
      "customers-list-admin": {
        "ClusterId": "customers",
        "Order": -100,
        "AuthorizationPolicy": "customers-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/customers",
          "Methods": [ "GET" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "customers-update-admin": {
        "ClusterId": "customers",
        "Order": -100,
        "AuthorizationPolicy": "customers-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/customers/{customerId}",
          "Methods": [ "PUT" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "customers-state-admin": {
        "ClusterId": "customers",
        "Order": -100,
        "AuthorizationPolicy": "customers-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/customers/{customerId}/state/{state}",
          "Methods": [ "PUT" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "customers-detail-self-or-admin": {
        "ClusterId": "customers",
        "Order": -50,
        "AuthorizationPolicy": "resource-owner-or-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/customers/{customerId}",
          "Methods": [ "GET" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "customers-state-get-self-or-admin": {
        "ClusterId": "customers",
        "Order": -50,
        "AuthorizationPolicy": "resource-owner-or-admin",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/customers/{customerId}/state",
          "Methods": [ "GET" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "customers-authenticated": {
        "ClusterId": "customers",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "gateway-api",
        "Match": {
          "Path": "/customers/{**remainder}"
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "admin-web-login-page": {
        "ClusterId": "frontend-admin",
        "Order": 500,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/login",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "admin-web-login-css": {
        "ClusterId": "frontend-admin",
        "Order": 500,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/login.css",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "admin-web-login-js": {
        "ClusterId": "frontend-admin",
        "Order": 500,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/login.js",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "admin-web-favicon": {
        "ClusterId": "frontend-admin",
        "Order": 500,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/favicon.svg",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "admin-web-frontend": {
        "ClusterId": "frontend-admin",
        "Order": 1000,
        "AuthorizationPolicy": "admin-frontend",
        "Match": {
          "Path": "/{**remainder}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "admin-identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5014/"
          }
        }
      },
      "customers": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "frontend-admin": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:17321/"
          }
        }
      }
    }
  }
}
